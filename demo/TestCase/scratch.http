############################################################
# 一、主线：申请 → 退回 → 重新提交 → 同意 → 老师确认 → APPROVED
############################################################
### 1. 学生（小明，studentId=1）登录获取token
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "loginType": "STUDENT",
  "username": "20210001",
  "password": "123456"
}

> {%
    // 处理登录响应，存储token和userId
    client.global.set("student_token", response.body.data.token);
    client.global.set("student_userId", response.body.data.userId);
    client.log("学生Token: " + response.body.data.token);
    client.log("学生ID: " + response.body.data.userId);
%}

<> 2025-12-24T203918.200.json

### 2. 学生发起请假（假条 #1）
# 2024-10-10 上午第1-2节，高数课病假

POST http://localhost:8080/api/leaves/apply
Content-Type: application/json
Authorization: Bearer {{student_token}}

{
  "studentId": {{student_userId}},
  "termId": 1,
  "leaveType": "SICK",
  "applyChannel": "BY_COURSE",
  "reason": "感冒发烧，需要到医院就诊",
  "proofUrl": null,
  "startTime": "2024-10-10T08:00:00",
  "endTime": "2024-10-10T12:00:00",
  "impacts": [
    {
      "offeringId": 1,
      "courseDate": "2024-10-10",
      "sectionStart": 1,
      "sectionEnd": 2
    }
  ]
}

<> 2025-12-24T203919.200.json
<> 2025-12-14T235900.200.json




